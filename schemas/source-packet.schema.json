{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vppuri-vjra/prd-genie-capstone/schemas/source-packet.schema.json",
  "title": "PRD Genie Source Packet",
  "description": "Canonical multi-source input envelope consumed by the Requirement Extractor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "run_id", "test_id", "producer", "sources", "submitted_at", "metadata"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "packet_id": { "type": "string", "pattern": "^SP-[A-Za-z0-9-]+$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$" },
    "test_id": { "type": ["string", "null"], "pattern": "^T(?:[1-9]|1[0-2])$" },
    "producer": { "enum": ["production_multi_source", "evaluation_control"] },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/source" }
    },
    "submitted_at": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "logical_input_contract", "route_policy"],
      "properties": {
        "language": { "const": "en" },
        "logical_input_contract": { "const": "requirement_extractor_input_v1" },
        "route_policy": { "const": "alternative_not_combined" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "producer": { "const": "production_multi_source" } } },
      "then": {
        "properties": {
          "sources": {
            "allOf": [
              { "contains": { "properties": { "source_type": { "const": "product_brief" } }, "required": ["source_type"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "source_type": { "const": "meeting_transcript" } }, "required": ["source_type"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "source_type": { "const": "stakeholder_notes" } }, "required": ["source_type"] }, "minContains": 1, "maxContains": 1 }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "location"],
      "properties": {
        "quote": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "pattern": "^line:[1-9][0-9]*$" },
        "speaker": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "source_name", "raw_text", "provenance", "citations", "metadata", "content_hash"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "source_type": { "enum": ["product_brief", "meeting_transcript", "stakeholder_notes", "stakeholder_clarification", "evaluation_test"] },
        "source_name": { "type": "string", "minLength": 1 },
        "raw_text": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "fixture_path"],
          "properties": {
            "origin": { "enum": ["controlled_fixture", "uploaded_document", "submitted_text"] },
            "fixture_path": { "type": ["string", "null"] }
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_version", "language"],
          "properties": {
            "document_version": { "type": "string", "minLength": 1 },
            "language": { "const": "en" },
            "meeting_date": { "type": ["string", "null"], "format": "date" }
          }
        },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
