{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vppuri-vjra/prd-genie-capstone/schemas/requirement-extraction.schema.json",
  "title": "PRD Genie Requirement Extraction",
  "description": "Evidence-linked output from the Requirement Extractor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "extraction_status", "summary", "items", "contradictions", "missing_information"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$" },
    "extraction_status": { "enum": ["complete", "partial", "no_requirements"] },
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/extractedItem" }
    },
    "contradictions": {
      "type": "array",
      "items": { "$ref": "#/$defs/contradiction" }
    },
    "missing_information": {
      "type": "array",
      "items": { "$ref": "#/$defs/missingItem" }
    },
    "extractor_notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "source_name", "location"],
      "properties": {
        "quote": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "source_type": { "enum": ["product_brief", "meeting_transcript", "stakeholder_notes", "stakeholder_clarification", "evaluation_test"] },
        "source_name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "speaker": { "type": ["string", "null"] },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "extractedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "statement", "status", "priority", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^(FR|NFR|AC|PER|STK|DDL|DEP|CON|ASM|RSK)-[0-9]{3}$" },
        "type": {
          "enum": ["functional_requirement", "non_functional_requirement", "acceptance_criterion", "persona", "stakeholder", "deadline", "dependency", "constraint", "assumption", "risk"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["stated", "suggested", "ambiguous", "contradictory"] },
        "priority": { "enum": ["Must Have", "Should Have", "Nice to Have", "Unspecified"] },
        "category": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "related_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(FR|NFR|AC|PER|STK|DDL|DEP|CON|ASM|RSK)-[0-9]{3}$" }
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "item_ids", "resolution_status", "clarification_question"],
      "properties": {
        "id": { "type": "string", "pattern": "^CTR-[0-9]{3}$" },
        "description": { "type": "string", "minLength": 1 },
        "item_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "resolution_status": { "const": "unresolved" },
        "clarification_question": { "type": "string", "minLength": 1 }
      }
    },
    "missingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "clarification_question"],
      "properties": {
        "id": { "type": "string", "pattern": "^MISS-[0-9]{3}$" },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "clarification_question": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
