{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vppuri-vjra/prd-genie-capstone/schemas/story-breakdown.schema.json",
  "title": "PRD Genie Story Breakdown",
  "description": "Traceable epics, features, and user stories produced from an approved PRD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "epics", "unresolved_questions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$" },
    "epics": { "type": "array", "items": { "$ref": "#/$defs/epic" } },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "epic": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "source_requirement_ids", "features"],
      "properties": {
        "id": { "type": "string", "pattern": "^EPIC-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source_requirement_ids": { "$ref": "#/$defs/sourceIds" },
        "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "source_requirement_ids", "stories"],
      "properties": {
        "id": { "type": "string", "pattern": "^FEAT-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "source_requirement_ids": { "$ref": "#/$defs/sourceIds" },
        "stories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/story" } }
      }
    },
    "story": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "persona", "capability", "benefit", "story", "priority", "acceptance_criteria", "dependencies", "source_requirement_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^US-[0-9]{3}$" },
        "persona": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "benefit": { "type": "string", "minLength": 1 },
        "story": { "type": "string", "pattern": "^As a[n]? .+, I want .+ so that .+\\.$" },
        "priority": { "enum": ["Must Have", "Should Have", "Nice to Have", "Unspecified"] },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_requirement_ids": { "$ref": "#/$defs/sourceIds" }
      }
    }
  }
}
