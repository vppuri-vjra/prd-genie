      ],
      "controlled_tbd": null,
      "future_condition": null,
      "decision_citation": {
        "source_id": "SRC-REALISTIC-CLAR-001",
        "source_name": "stakeholder-clarifications-2026-08-07.md",
        "location": "line:16",
        "quote": "- DEC-2026-08-07-GAP-007: Hybrid refresh: 15-minute automatic refresh plus manual refresh of the latest available precomputed warehouse data, a last-updated timestamp, and protection against excessive repeated requests; no direct live-database query.",
        "content_hash": "sha256:a10d68b226cf1f4ac48dc1c08ddc6205e137146657db035c3cae5da46dad5300"
      },
      "original_evidence": [
        {
          "source_id": "SRC-REALISTIC-PB-001",
          "source_name": "product-brief.txt",
          "location": "line:18",
          "quote": "3. Data should refresh every 15 minutes (not real-time, to manage cost)",
          "content_hash": "sha256:a8f93fd8b88bd8e52b69197b378cf655be87d88a34d020ce992df6acd6e33ce5"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:52",
          "quote": "Priya: We need the dashboard to auto-refresh every 5 seconds so users always see the latest data.",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:56",
          "quote": "Kevin: Yeah, from a DevOps perspective, that's concerning. Performance is critical. We need to minimize API calls. Our infrastructure can't handle that load.",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:58",
          "quote": "Priya: But users complain that data is stale. They want real-time.",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:62",
          "quote": "Priya: Let's just do the 5-second refresh for now.",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:64",
          "quote": "Kevin: I strongly disagree. We'll have outages.",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:90",
          "quote": "- Discussed dashboard... something about real-time updates",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        },
        {
          "source_id": "SRC-REALISTIC-MT-001",
          "source_name": "meeting-transcripts.txt",
          "location": "line:91",
          "quote": "- John mentioned something about real-time... need to check",
          "content_hash": "sha256:15111349acf5fa92a2f5a33cbbedfc06765e2bb341473d451c49d5123f49dcc8"
        }
      ],
      "supersession": null,
      "required_prd_citation_label": "DEC-2026-08-07-GAP-007 — Stakeholder Clarification, Vipin, 2026-08-07"
